# Native OpenXR dependencies; cross builds use pinned source trees.
set(JFG_SDL_SOURCE "" CACHE PATH "SDL2 source tree for Windows/Android builds")
set(JFG_OPENXR_SDK "" CACHE PATH "Khronos OpenXR-SDK source tree")
set(JFG_HOST_FILE_TO_C "" CACHE FILEPATH "Host file_to_c executable for cross builds")
set(JFG_VULKAN_ONLY ON CACHE BOOL "Build the native Vulkan/OpenXR renderer")
if(JFG_VULKAN_ONLY)
  add_compile_definitions(JFG_VULKAN_ONLY)
endif()
if(MINGW)
  # Pinned dependencies rely on C allocation declarations included by MSVC.
  add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:-include>" "$<$<COMPILE_LANGUAGE:CXX>:cstdlib>")
endif()
if(ANDROID)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()
if(JFG_SDL_SOURCE)
  set(SDL_TEST OFF CACHE BOOL "" FORCE)
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_STATIC_PIC ON CACHE BOOL "" FORCE)
  if(ANDROID)
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
  else()
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
  endif()
  add_subdirectory("${JFG_SDL_SOURCE}" "${CMAKE_BINARY_DIR}/SDL2" EXCLUDE_FROM_ALL)
else()
  find_package(SDL2 REQUIRED)
endif()
if(NOT TARGET SDL2::SDL2 AND TARGET SDL2-static)
  add_library(SDL2::SDL2 ALIAS SDL2-static)
endif()
set(SDL2_INCLUDE_DIRS "$<TARGET_PROPERTY:SDL2::SDL2,INTERFACE_INCLUDE_DIRECTORIES>")
set(SDL2_LIBRARIES SDL2::SDL2)
if(JFG_OPENXR_SDK)
  set(BUILD_LOADER ON CACHE BOOL "" FORCE)
  set(DYNAMIC_LOADER ON CACHE BOOL "" FORCE)
  set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
  set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_CONFORMANCE_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_WITH_SYSTEM_JSONCPP OFF CACHE BOOL "" FORCE)
  add_subdirectory("${JFG_OPENXR_SDK}" "${CMAKE_BINARY_DIR}/OpenXR" EXCLUDE_FROM_ALL)
  if(MINGW)
    # The SDK's non-MSVC branch applies an ELF export map to PE linkers.
    # Its Windows dllexport declarations already export the loader API.
    set_property(TARGET openxr_loader PROPERTY LINK_FLAGS "")
    set_property(TARGET openxr_loader PROPERTY PREFIX "")
  endif()
  set(JFG_OPENXR_TARGET openxr_loader)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(OPENXR REQUIRED IMPORTED_TARGET openxr)
  set(JFG_OPENXR_TARGET PkgConfig::OPENXR)
endif()
