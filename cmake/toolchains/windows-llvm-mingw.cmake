set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(JFG_LLVM_MINGW "$ENV{JFG_LLVM_MINGW}" CACHE PATH "LLVM-MinGW root")
if(NOT EXISTS "${JFG_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
  message(FATAL_ERROR "Set JFG_LLVM_MINGW to the extracted LLVM-MinGW toolchain")
endif()
set(CMAKE_C_COMPILER "${JFG_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${JFG_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${JFG_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${JFG_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
