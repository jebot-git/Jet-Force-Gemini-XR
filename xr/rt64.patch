+#ifndef RT64_XR_HUD_HLSLI
+#define RT64_XR_HUD_HLSLI
+#include "shared/rt64_raster_params.h"
+
+// XR UI opts into continuous UVs through the regular upscale2D render flag.
+float2 rasterTextureUV(float2 uv, float2 derivativeX, float2 derivativeY,
+                      float2 pixel, float2 scale, float misalignment, bool upscale2D) {
+    if (!upscale2D) {
+        float2 screen = floor(pixel);
+        screen.x += misalignment;
+        uv -= fmod(screen, scale.yy) * float2(derivativeX.x, derivativeY.y);
+    }
+    return uv;
+}
+
+float4 xrHudPosition(float4 position, RasterParams params) {
+    const float depth = saturate(position.z / max(abs(position.w), 0.00001f));
+    float4 projected = position.x * params.xrHudRows[0] +
+                       position.y * params.xrHudRows[1] +
+                       position.w * params.xrHudRows[3];
+    // Overlay depth is independent of world depth, while retaining the source
+    // ordering inside 3D HUD models instead of putting every face at z = 0.
+    projected.z = (0.0001f + depth * 0.0001f) * projected.w;
+    return projected;
+}
+#endif
