-                }
-
-                XRRFreeCrtcInfo(crtcInfo);
-            }
-        }
-
-        if (activeModeID == 0L) {
-            fprintf(stderr, "Unable to find active mode through XRRGetScreenResources and XRRGetCrtcInfo.\n");
