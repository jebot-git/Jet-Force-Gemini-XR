-            return;
-        }
-
-        SDL_DisplayMode displayMode = {};
-        int modeResult = SDL_GetCurrentDisplayMode(displayIndex, &displayMode);
-        if (modeResult != 0) {
-            fprintf(stderr, "SDL_GetCurrentDisplayMode failed. Error: %s.\n", SDL_GetError());
-            return;
-        }
